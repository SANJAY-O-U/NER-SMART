PORT=5000
MONGO_URI=your-mongodb-connection-string
APP_MODE=demo

# Phase 2 — IMD weather integration (NOT VERIFIED, see IMD_INTEGRATION.md).
# Requires an account registered with an official .gov.in/.nic.in/.cdot.in/
# .cdac.in/.nhai.org/.icar.org.in email at https://api.imd.gov.in/public/register.php
# Leave unset to run with weather integration honestly UNAVAILABLE.
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
IMD_API_KEY=
IMD_API_AUTH_HEADER=Authorization
IMD_API_AUTH_SCHEME=Bearer

# Phase 3B — NDMA SACHET (VERIFIED live, no credentials needed).
# 0 disables automatic polling.
SACHET_POLL_INTERVAL_MINUTES=15
