PORT=5000
MONGO_URI=your-mongodb-connection-string
APP_MODE=demo

# --- Phase 1 — Production Safety Hardening (see POST_PPT_PRODUCTION_AUDIT
# and PHASE1_SECURITY_HARDENING.md) ---

# NODE_ENV=production hides internal error detail (stack traces, Mongoose/
# MongoDB messages) from 5xx API responses. Leave unset for local
# development — errors stay fully visible, matching this app's existing
# local-dev-only default.
NODE_ENV=
#
# Phase 7A — with NODE_ENV=production the server refuses to start unless
# MONGO_URI, NER_API_KEY, NER_ALLOWED_ORIGINS (explicit origins, no "*"),
# WEATHER_PROVIDER and that provider's key (WEATHERAPI_API_KEY for
# weatherapi) are set. Missing variables are named in the startup log;
# values are never printed. See src/config/productionEnv.js.
# Production should also set APP_MODE to anything other than "demo"
# (e.g. APP_MODE=production) so demo reset/simulation stay disabled.

# Shared-secret write-access gate. Required on every POST/PATCH/PUT/DELETE
# application write endpoint EXCEPT POST /api/incidents (the Flutter field
# app's ingestion endpoint — see PHASE1_SECURITY_HARDENING.md for why) and
# the read-only/compute-only endpoints (GET *, POST /api/risk/predict,
# POST /api/routes/recommend*). Send as header: x-api-key: <value>.
# Generate a real value with e.g. `openssl rand -hex 32` — never a
# guessable string. Never hardcode the real value anywhere; it belongs
# only in backend/.env (gitignored), never committed, never logged.
NER_API_KEY=

# Comma-separated list of allowed browser origins for CORS (replaces the
# previous wildcard `cors()`). Example for local development:
# NER_ALLOWED_ORIGINS=http://localhost:5173
# An empty/unset value allows NO cross-origin browser request (fails
# closed) — non-browser callers (curl, server-to-server) are unaffected,
# since CORS only applies to browser-issued cross-origin requests.
NER_ALLOWED_ORIGINS=http://localhost:5173

# Rate limiting (express-rate-limit). Applies globally at the "general"
# level (all requests) and additionally, more strictly, on write routes.
# Defaults below are generous enough not to throttle normal dashboard
# reads (e.g. the 6s incident poll) or a real demo session.
NER_RATE_LIMIT_WINDOW_MINUTES=15
NER_RATE_LIMIT_MAX=300
NER_WRITE_RATE_LIMIT_MAX=30

# Phase 7A — number of reverse proxies/load balancers in front of the
# backend (e.g. 1 on most PaaS hosts). Makes the per-IP rate limiter see
# the real client IP via X-Forwarded-For. Leave unset when clients
# connect directly (local development).
NER_TRUST_PROXY_HOPS=

# --- Weather provider selection (see WEATHER_PROVIDER.md) ---
# "weatherapi" (default) uses WeatherAPI.com, a third-party feed — NOT an
# official government source. "imd" switches to the India Meteorological
# Department integration below, which requires credentials this project
# does not have (see IMD_INTEGRATION.md) and stays UNAVAILABLE without them.
WEATHER_PROVIDER=weatherapi

# --- WeatherAPI.com (ACTIVE by default) ---
# Free key from https://www.weatherapi.com/. Backend-only — never sent to
# the frontend/Flutter, never logged, never returned by an API response.
WEATHERAPI_BASE_URL=https://api.weatherapi.com/v1
WEATHERAPI_API_KEY=
# Minutes between WeatherAPI ingestion passes (applies to whichever
# provider WEATHER_PROVIDER selects). 0 disables automatic polling.
WEATHER_POLL_INTERVAL_MINUTES=15

# --- Phase 2 — IMD weather integration (FUTURE provider, NOT VERIFIED,
# see IMD_INTEGRATION.md). Requires an account registered with an
# official .gov.in/.nic.in/.cdot.in/.cdac.in/.nhai.org/.icar.org.in email
# at https://api.imd.gov.in/public/register.php. Only used when
# WEATHER_PROVIDER=imd above; irrelevant while WeatherAPI is active.
IMD_API_BASE_URL=https://api.imd.gov.in/api/v1
IMD_API_KEY=
IMD_API_AUTH_HEADER=Authorization
IMD_API_AUTH_SCHEME=Bearer

# Comma-separated list of real IMD AWS/ARG station IDs to poll (e.g.
# "42314,42410"). Obtain confirmed station IDs for the NER corridor via
# an authenticated GET /api/v1/aws_data_mapping call once IMD_API_KEY is
# set — see IMD_INTEGRATION.md "Geographic limitations". Do not guess or
# reuse station IDs found only in code comments/test fixtures; those are
# illustrative placeholders, not verified real stations. Leave unset to
# keep IMD ingestion disabled.
IMD_STATION_IDS=
# Minutes between IMD weather ingestion passes when WEATHER_PROVIDER=imd.
# 0 disables automatic polling (default — safe until both IMD_API_KEY and
# IMD_STATION_IDS are real, confirmed values; ingestion also stays off if
# either is unset, regardless of this value).
IMD_WEATHER_POLL_INTERVAL_MINUTES=0

# Phase 3B — NDMA SACHET (VERIFIED live, no credentials needed).
# 0 disables automatic polling.
SACHET_POLL_INTERVAL_MINUTES=15

# Phase 5 — AI-assisted incident classification/summarization (aiService.js).
# Optional. If unset, incident analysis always uses the deterministic
# DEMO_FALLBACK keyword classifier — never silently pretended to be live
# AI. When set, real analysis is attempted first and falls back safely on
# any network/timeout/malformed-response failure. Backend-only; never
# sent to the Flutter app or exposed in any API response.
ANTHROPIC_API_KEY=
