# Base URL for the NER-SMART backend API.
# Copy this file to .env and adjust if your backend runs elsewhere.
VITE_API_BASE_URL=http://localhost:5000/api

# VITE_API_KEY — LOCAL DEVELOPMENT ONLY (Phase 10.5.3).
#
# MUST NOT be configured in Vercel or any other production/preview build
# environment. Every VITE_* value is bundled into public JavaScript, so a
# key here would expose the backend's NER_API_KEY to anyone. `vite build`
# FAILS if VITE_API_KEY is set (see vite.config.js), and src/services/api.js
# only reads it under `vite dev`. Deployed dashboards are read-only.
#
# For local development write actions (incident status workflow, demo
# reset, landslide simulation) against a LOCAL backend, set it to your
# local backend's NER_API_KEY in frontend/.env.development.local
# (gitignored; loaded by `vite dev` only, never by `vite build`).
# Leave it empty here.
VITE_API_KEY=
