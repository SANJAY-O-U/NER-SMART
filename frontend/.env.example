# Base URL for the NER-SMART backend API.
# Copy this file to .env and adjust if your backend runs elsewhere.
VITE_API_BASE_URL=http://localhost:5000/api

# Phase 1.5 — Client Compatibility. Must match the backend's NER_API_KEY
# (see backend/.env.example) for local development. Sent as the
# x-api-key header on every POST/PATCH/PUT/DELETE call the dashboard
# makes — see src/services/api.js. Never commit a real value here; the
# real local key belongs only in frontend/.env (gitignored).
#
# Note: any value here is bundled into the built JS and visible to
# anyone who opens browser devtools — this is an accepted limitation of
# the minimal shared-secret design (see PHASE1_SECURITY_HARDENING.md),
# not a bug in this phase.
VITE_API_KEY=
